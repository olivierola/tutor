# ── Front-end (Vite) ────────────────────────────────────────
# Copy to `.env.local` and fill in. Without these the app runs in
# local-only mode (localStorage + rule-based tutor), no backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Edge function secrets (set via `supabase secrets set …`) ──
# These are NOT read by the front-end. They live on the server.
#   ANTHROPIC_API_KEY=sk-ant-...
#   ANTHROPIC_MODEL=claude-opus-4-8       # optional override
#   SUPABASE_SERVICE_ROLE_KEY=...         # used by the `share` GET path
